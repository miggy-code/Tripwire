# PostgreSQL connection. Use a managed production database with TLS.
DATABASE_URL=postgresql://tripwire:change-me@localhost:5432/tripwire
APP_URL=http://127.0.0.1:3000
# Get these from your own Clerk application. Never commit the real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workspace
# Enable Organizations in Clerk for team workspaces.
# Only these Clerk user IDs may trigger manual global collection.
TRIPWIRE_ADMIN_USER_IDS=
# Generate a unique >=32-character secret for external cron collection.
CRON_SECRET=
COLLECTION_INTERVAL_MINUTES=360
